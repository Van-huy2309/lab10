APP_NAME="Trang Suc Cua Huy"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com
APP_KEY=THAY_BANG_APP_KEY_DA_TAO
TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=mysql-1fa3440-lab10.l.aivencloud.com
DB_PORT=11279
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=THAY_BANG_MAT_KHAU_AIVEN
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info
PORT=10000
RUN_MIGRATIONS=true
RUN_SEEDERS=false

SEED_ADMIN_NAME=Shop Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_TOI_THIEU_12_KY_TU

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_VERIFY_SSL=true
MOMO_REDIRECT_URL=https://YOUR-SERVICE.onrender.com/payment/momo/callback
MOMO_IPN_URL=https://YOUR-SERVICE.onrender.com/payment/momo/ipn

GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_VERIFY_SSL=true
GHN_FROM_DISTRICT_ID=1442
GHN_DEFAULT_WEIGHT=200

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
